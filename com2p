def min_coins(coins, amount):
    dp = [float('inf')] * (amount + 1)
    dp[0] = 0
    for i in range(1, amount + 1):
        for coin in coins:
            if coin <= i:
                dp[i] = min(dp[i], 1 + dp[i - coin])
    return dp[amount]
coin_types = [1, 3, 5]
target_amount = 9
output = min_coins(coin_types, target_amount)
print(f"Input: Coin types: {coin_types}. Amount to express: {target_amount}")
print(f"Output: {output}")
